# =============================================================================
# JKR AI — Environment Configuration
# GX10 Performance-Tuned
# =============================================================================

# ---------- MTAI API (required) ----------
MTAI_API_BASE_URL=https://api.mtai.com.my/v1
MTAI_API_KEYS=
MTAI_MODEL=Qwen/Qwen3.5-122B

# ---------- GPU Acceleration ----------
EMBEDDING_DEVICE=cuda
CROSS_ENCODER_DEVICE=cuda

# ---------- HuggingFace Cache ----------
HF_HOME=/opt/jkr-ai/.hf_cache

# ---------- Retrieval Tuning ----------
RETRIEVAL_TOP_K=15
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------- Embedding ----------
LOCAL_EMBEDDING_MODEL=mesolitica/mistral-embedding-191m-8k-contrastive
EMBEDDING_BATCH_SIZE=256
INGEST_BATCH_SIZE=500

# ---------- Cache ----------
CACHE_TTL_SECONDS=600

# ---------- ChromaDB ----------
CHROMA_PERSIST_DIR=/opt/jkr-ai/chroma_db

# ---------- Paths ----------
LOCAL_KNOWLEDGE_PATH=/opt/jkr-ai/knowledge
LOCAL_DOCUMENTS_PATH=/opt/jkr-ai/documents
CSV_LOG_PATH=/opt/jkr-ai/logs/conversations.csv
FEEDBACK_CSV_PATH=/opt/jkr-ai/logs/feedback.csv
